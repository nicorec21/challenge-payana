# Copiar a `.env` y completar. `.env` está en .gitignore y NO se commitea.
#
# Criterio de qué vive acá: SECRETOS, ENDPOINTS y RUTAS.
# Las reglas de negocio (tasas de comisión, mapeo de cuentas contables,
# ventanas de conciliación) NO van acá: viven en `src/conciliacion/config.py`,
# versionadas en git. Motivo: son decisiones auditables que deben poder
# revisarse en un diff y reproducirse entre corridas, no configuración de
# entorno. Un cambio de tasa tiene que quedar en el historial.

# ── Wompi ────────────────────────────────────────────────────────────────
# Dashboard → Desarrollo → Llaves del API.
# ⚠️ Cuenta PRODUCTIVA. Solo operaciones de lectura (GET).
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de firma de webhooks. Solo necesario si validamos payloads
# recibidos; no hace falta para leer la API.
WOMPI_EVENTS_SECRET=

# ID de comercio. Aparece en el nombre de los reportes (`rs-203607`) y como
# prefijo de los IDs de transacción (`1203607-...`).
WOMPI_MERCHANT_ID=203607

# Verificar contra la doc oficial antes de usar.
WOMPI_API_BASE_URL=https://production.wompi.co/v1

# ── Odoo (ERP) ───────────────────────────────────────────────────────────
ODOO_URL=https://payana-prod.odoo.com
ODOO_DB=payajoe-payana-dev-payana-prod-19688558
ODOO_USER_ID=10
ODOO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ODOO_COMPANY_ID=2

# Diarios contables. 48 = Wompi, 49 = Bancolombia.
ODOO_JOURNAL_WOMPI=48
ODOO_JOURNAL_BANCOLOMBIA=49

# ── Rutas locales ────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
OUT_DIR=data/out
DATABASE_PATH=conciliacion.db
